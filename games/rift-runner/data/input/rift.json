{
  "doc": "Default bindings. Keyboard+mouse: WASD move, mouse look, Space jump, Shift sprint, Ctrl/C crouch, Mouse0 fire, E use, R reload, 1-9 or wheel switch weapons. Gamepad: standard mapping.",
  "actions": {
    "moveForward": ["KeyW", "ArrowUp", "Pad:LeftY-"],
    "moveBack": ["KeyS", "ArrowDown", "Pad:LeftY+"],
