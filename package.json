    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "22.20.4",
    "@types/three": "0.186.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
