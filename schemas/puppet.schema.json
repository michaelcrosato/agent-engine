{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "puppet (data/puppets)",
  "description": "Procedural model: a tree of primitive parts with materials; animated by clips.",
  "type": "object",
  "properties": {
    "doc": {
      "default": "",
      "type": "string"
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "default": "",
            "description": "Name for parenting and animation tracks",
            "type": "string"
          },
          "parent": {
            "default": "",
            "description": "Parent part id; empty = model root",
            "type": "string"
          },
          "shape": {
            "default": "box",
            "type": "string",
            "enum": [
              "box",
              "sphere",
              "capsule",
              "cylinder",
              "cone",
              "torus",
              "plane",
              "wedge",
              "lathe",
              "extrude"
            ]
          },
          "size": {
            "default": [
              1,
              1,
              1
            ],
            "description": "Full size [x, y, z]. sphere: x = diameter; capsule/cylinder/cone: x = diameter, y = height",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "pos": {
            "default": 0,
            "description": "Position of the pivot relative to the parent",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "rot": {
            "default": 0,
            "description": "Yaw degrees or [x, y, z] Euler degrees (YXZ)",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "scale": {
            "default": 1,
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            ]
          },
          "pivot": {
            "default": "bottom",
            "description": "Origin on the shape",
            "type": "string",
            "enum": [
              "bottom",
              "center",
              "top"
            ]
          },
          "material": {
            "default": "default",
            "description": "Material name from the active look",
            "type": "string"
          },
          "color": {
            "description": "Tint multiplied with the material color",
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
          },
          "segments": {
            "default": 16,
            "description": "Roundness of curved shapes",
            "type": "integer",
            "minimum": 3,
            "maximum": 64
          },
          "profile": {
            "default": [],
            "description": "lathe: [radius, y] points, bottom to top",
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "points": {
            "default": [],
            "description": "extrude: [x, y] outline; size.z = depth",
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "thickness": {
            "default": 0.25,
            "description": "torus: tube diameter",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uv": {
            "default": "box",
            "description": "world = textures tile per meter",
            "type": "string",
            "enum": [
              "box",
              "world"
            ]
          },
          "hidden": {
            "default": false,
            "type": "boolean"
          },
          "shadow": {
            "default": true,
            "description": "Cast shadows",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "description": "Primitive parts; parents must come first"
    },
    "clips": {
      "default": {},
      "description": "Animation role → clip id, e.g. { \"idle\": \"grunt-idle\", \"walk\": \"grunt-walk\" }",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string",
      "description": "Editor schema hint (ignored by the engine)"
    }
  },
  "required": [
    "parts"
  ],
  "additionalProperties": false
}
