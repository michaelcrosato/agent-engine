              },
              "rough": {
                "default": -1,
                "description": "Roughness where the pattern is (-1 = unchanged)",
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "required": [
              "op"
            ],
            "additionalProperties": false,
            "description": "Sets every pixel to a color (and optionally a roughness). Usually the first layer."
          },
