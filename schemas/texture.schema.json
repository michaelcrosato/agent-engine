      "maximum": 9007199254740991
    },
    "roughness": {
      "default": 0.8,
      "description": "Base roughness before layers",
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "normal": {
      "default": 2,
      "description": "Normal-map strength from height (0 = none)",
      "type": "number",
      "minimum": 0,
      "maximum": 16
